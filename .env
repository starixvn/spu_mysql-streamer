#network
NETWORK_NAME=cts-neo4j-network
MYSQL_NETWORK_NAME=cts_network
NETWORK_DRIVER=bridge
NETWORK_EXTERNAL=true

#pyphon
PYTHON_TAG=3.8
PYTHON_UNBUFFERED=1

CONNECTOR_TZ="America/La_Paz"

#connector-sender
CONNECTOR_SENDER_HOST=cts-mysql-streamer-sender
CONNECTOR_SENDER_LOGS=./sender/logs/
CONNECTOR_SENDER_CONF=./sender/conf/

#connector-receiver
CONNECTOR_RECEIVER_HOST=cts-mysql-streamer-receiver
CONNECTOR_RECEIVER_SENDER_LOGS=./receiver/logs/
CONNECTOR_RECEIVER_SENDER_CONF=./receiver/conf/
